#include <iostream>
using namespace std;

// Print matrix with highlighting
void printMatrix(int **D, int **prev, int n) {
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {

            if (D[i][j] != prev[i][j]) {
                cout << "[" << D[i][j] << "] ";
            } else {
                cout << D[i][j] << " ";
            }
        }
        cout << endl;
    }
}

// Print graph edges
void printGraph(int **W, int n) {
    cout << "\nGraph (Edge List):\n";
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            if (W[i][j] != 0 && i != j) {
                cout << i << " -> " << j << " = " << W[i][j] << endl;
            }
        }
    }
}

// Floyd Algorithm
void floyd(int **W, int n) {

    int **D = new int*[n];
    int **prev = new int*[n];

    for (int i = 0; i < n; i++) {
        D[i] = new int[n];
        prev[i] = new int[n];
    }


    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            D[i][j] = W[i][j];

    cout << "\nOriginal Matrix:\n";
    printMatrix(D, D, n);

    for (int k = 0; k < n; k++) {


        for (int i = 0; i < n; i++)
            for (int j = 0; j < n; j++)
                prev[i][j] = D[i][j];

        cout << "\nStep " << k + 1 << ":\n";

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {

                if (i != j && D[i][k] != 0 && D[k][j] != 0) {

                    if (D[i][j] == 0 || D[i][j] > D[i][k] + D[k][j]) {
                        D[i][j] = D[i][k] + D[k][j];
                    }
                }
            }
        }

        printMatrix(D, prev, n);
    }

    cout << "\nFinal Shortest Path Matrix:\n";
    printMatrix(D, D, n);


    for (int i = 0; i < n; i++) {
        delete[] D[i];
        delete[] prev[i];
    }
    delete[] D;
    delete[] prev;
}

int main() {
    int n;

    cout << "Enter number of vertices: ";
    cin >> n;


    int **W = new int*[n];
    for (int i = 0; i < n; i++) {
        W[i] = new int[n];
    }

    cout << "Enter adjacency matrix (0 for no edge):\n";

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            cin >> W[i][j];
        }
    }

    printGraph(W, n);
    floyd(W, n);

    // free memory
    for (int i = 0; i < n; i++) {
        delete[] W[i];
    }
    delete[] W;

    return 0;
}
